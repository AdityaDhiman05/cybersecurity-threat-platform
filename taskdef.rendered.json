{
  "family": "threat-platform",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::279391565053:role/threatPlatformTaskExecutionRole",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "dashboard",
      "image": "279391565053.dkr.ecr.ap-south-1.amazonaws.com/threat-platform:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 8501, "protocol": "tcp" }
      ],
      "secrets": [
        { "name": "API_KEY", "valueFrom": "arn:aws:secretsmanager:ap-south-1:279391565053:secret:threat-platform/api-key-5UIamC" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/threat-platform",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "dashboard"
        }
      }
    }
  ]
}